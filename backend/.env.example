
APP_NAME=CollabAI API
APP_VERSION=0.1.0
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Render Free blocks outbound SMTP; use Resend's HTTPS API there.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=CollabAI <noreply@your-verified-domain.com>

MONGODB_URI=your_mongodb_atlas_connection_string
MONGODB_DB_NAME=collab_ai

MONGODB_MAX_POOL_SIZE=xx
MONGODB_MIN_POOL_SIZE=xx
MONGODB_SERVER_SELECTION_TIMEOUT_MS=xxxx
MONGODB_CONNECT_TIMEOUT_MS=xxxxx

# Optional: point to a mounted persistent Render disk to cache the ONNX model
# across deploys (for example, /var/data/fastembed).
FASTEMBED_CACHE_PATH=

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret

# Groq-hosted LLM for the workspace Summarizer agent (backend only)
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

SESSION_COOKIE_NAME=xxxxxxxxxxx
SESSION_TTL_DAYS=x
COOKIE_SECURE=xxxxx
COOKIE_SAMESITE=xxxxxxx
